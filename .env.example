# ============================================================
# Discord Music Bot - Environment Variables
# انسخ هذا الملف إلى .env وعبّي القيم
# Copy this file to .env and fill in the values
# KEEP THIS FILE SECRET - Never commit to git!
# ============================================================

# --- Bot tokens (supports multiple bots) ---
DISCORD_TOKEN_1=your_discord_bot_token_here
# DISCORD_TOKEN_2=your_second_bot_token_here
# DISCORD_TOKEN_3=...

# Optional: comma-separated Discord user IDs allowed to use the #mp panel.
# If omitted on a fresh deployment, config.example.json starts with no owners.
# OWNER_IDS=123456789012345678,987654321098765432

# Optional: location for runtime config when the default folder is not writable.
# CONFIG_PATH=/home/container/config.json

# ============================================================
# YouTube Authentication (يمنع خطأ: Sign in to confirm you're not a bot)
# ============================================================

# الطريقة الأفضل (موصى بها): ملف كوكيز بجانب index.js
# أنشئه تلقائياً بالأمر:  npm run cookies

# أو ضع ملف cookies.txt يدوياً (لا تحتاج أي متغير هنا - يُكتشف تلقائياً)
# YTDLP_COOKIES_FILE=C:\full\path\to\cookies.txt

# طريقة بديلة: قراءة الكوكيز من متصفح مثبت (يجب إغلاق المتصفح تماماً أثناء التشغيل،
# وقد تفشل مع Chrome/Edge الحديثة بسبب تشفير DPAPI - استخدم cookies.txt بدلاً منها)
# YTDLP_COOKIES_FROM_BROWSER=edge

# خيارات متقدمة (اختيارية):
# وكيل للطلبات (proxy) لتجنب حجب IP السيرفر
# YTDLP_PROXY=http://user:pass@host:port

# عملاء تشغيل يوتيوب عند غياب المصادقة
# YTDLP_PLAYER_CLIENTS=default

# عملاء بديلة تُجرب تلقائياً عند ظهور bot-check
# YTDLP_FALLBACK_CLIENTS=tv,web_safari,mweb,ios

# تعطيل التحديث التلقائي الثنائي لـ yt-dlp (الافتراضي: تحديث كل 12 ساعة)
# YTDLP_AUTO_UPDATE=0
# YTDLP_AUTO_UPDATE_HOURS=12

{
  "name": "discord-music-panel-bot",
  "version": "1.0.0",
  "description": "Professional Discord Music Bot with Multi-Bot Control Panel (#mp)",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:pm2": "pm2 start ecosystem.config.js",
    "test": "node .test-sandbox/run-tests.js && node .test-sandbox/run-spread-tests.js && node .test-sandbox/test-hardened-json.js",
    "cookies": "node scripts/export-cookies.js",
    "setup:hosting": "node scripts/patch-ytdlp.js",
    "postinstall": "node yt-dlp-patch.js && (node scripts/patch-ytdlp.js || echo '[yt-dlp] skipped: scripts/patch-ytdlp.js not present') || true"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@distube/soundcloud": "^2.0.4",
    "@distube/spotify": "^2.0.2",
    "@distube/yt-dlp": "^2.0.1",
    "@distube/ytdl-core": "^4.16.12",
    "discord.js": "^14.27.0",
    "distube": "^5.2.3",
    "dotenv": "17.4.2",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.8.4",
    "opusscript": "^0.0.8",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "pm2": "^7.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "tar": "^7.5.22"
  },
  "allowScripts": {
    "@discordjs/opus": true,
    "@distube/yt-dlp": true,
    "ffmpeg-static": true
  }
}
